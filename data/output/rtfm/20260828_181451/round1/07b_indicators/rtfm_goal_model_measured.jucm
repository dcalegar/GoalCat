<?xml version="1.0" encoding="UTF-8"?>
<urn:URNspec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:grl="http:///grl.ecore" xmlns:grl.kpimodel="http:///grl/kpimodel.ecore" xmlns:urn="http:///urn.ecore" name="RTFM Goal Model" author="goalcat (v1.2, artificial -- see data/goals/rtfmGM_description.md)" created="August 18, 2026, 12:00:00 AM EDT" modified="August 25, 2026, 12:00:00 AM EDT" specVersion="1.0" urnVersion="1.27" nextGlobalID="194">
  <grlspec>
    <intElements name="Every issued fine reaches a lawful, documented closure" id="2" type="Goal" decompositionType="And"/>
    <intElements name="Fine is issued and formally communicated" id="3" type="Goal" decompositionType="And"/>
    <intElements name="Fine case is resolved" id="4" type="Goal" decompositionType="Or"/>
    <intElements name="Fine becomes enforceable and is resolved" id="5" type="Goal" decompositionType="And"/>
    <intElements name="Enforced case is closed" id="6" type="Goal" decompositionType="Or"/>
    <intElements name="Contested appeal is resolved" id="7" type="Goal" decompositionType="Xor"/>
    <intElements name="Create Fine" id="8" type="Task"/>
    <intElements name="Send Fine" id="9" type="Task"/>
    <intElements name="Insert Fine Notification" id="10" type="Task"/>
    <intElements name="Add Penalty" id="11" type="Task"/>
    <intElements name="Resolve via timely payment" id="12" type="Task"/>
    <intElements name="Resolve via delinquent payment" id="13" type="Task"/>
    <intElements name="Resolve via administrative appeal to the Prefecture" id="14" type="Task" decompositionType="And"/>
    <intElements name="Insert Date Appeal to Prefecture" id="15" type="Task"/>
    <intElements name="Send Appeal to Prefecture" id="16" type="Task"/>
    <intElements name="Receive Result Appeal from Prefecture" id="17" type="Task"/>
    <intElements name="Notify Result Appeal to Offender" id="18" type="Task"/>
    <intElements name="Resolve via judicial appeal to the Judge" id="19" type="Task"/>
    <intElements name="Resolve via coercive credit collection" id="20" type="Task"/>
    <intElements name="Minimize administrative &amp; enforcement cost" id="21" type="Softgoal"/>
    <intElements name="Maximize timely fine revenue" id="22" type="Softgoal"/>
    <intElements name="Preserve offender's due-process rights" id="23" type="Softgoal"/>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Time to fine dispatch (days)" id="112" type="Indicator" groups="115">
      <metadata name="goalcat:measure" value="duration_days"/>
      <metadata name="goalcat:from" value="Create Fine"/>
      <metadata name="goalcat:to" value="Send Fine"/>
      <metadata name="goalcat:to_occurrence" value="first"/>
      <metadata name="goalcat:aggregate" value="mean"/>
      <metadata name="goalcat:provenance" value="statutory"/>
      <metadata name="goalcat:source" value="threshold 90 d and worst 360 d: Art. 201 D.Lgs. 285/1992 (ordinary notification term; extended term for parties resident abroad). target 30 d: L. 241/1990 art. 2 c.2, the default term for concluding an administrative proceeding, applied by analogy as an operational aspiration -- the specific term in Art. 201 is what binds."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Time to appeal filing, Prefecture (days)" id="113" type="Indicator" groups="115">
      <metadata name="goalcat:measure" value="duration_days"/>
      <metadata name="goalcat:from" value="Insert Fine Notification"/>
      <metadata name="goalcat:to" value="Insert Date Appeal to Prefecture|Send Appeal to Prefecture"/>
      <metadata name="goalcat:to_occurrence" value="first"/>
      <metadata name="goalcat:applies_when" value="Insert Date Appeal to Prefecture|Send Appeal to Prefecture"/>
      <metadata name="goalcat:aggregate" value="mean"/>
      <metadata name="goalcat:provenance" value="statutory"/>
      <metadata name="goalcat:source" value="threshold 60 d: Art. 203 D.Lgs. 285/1992, the window for a ricorso al Prefetto; corroborated by the Delay Prefecture' &lt; 60 days guard in Mannhardt et al. (2016, Fig. 8). target == threshold because an admissibility window is a boundary, not a gradient. worst 120 d illustrative (2x the window)."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Time to appeal filing, Judge (days)" id="175" type="Indicator" groups="115">
      <metadata name="goalcat:measure" value="duration_days"/>
      <metadata name="goalcat:from" value="Insert Fine Notification"/>
      <metadata name="goalcat:to" value="Appeal to Judge"/>
      <metadata name="goalcat:to_occurrence" value="first"/>
      <metadata name="goalcat:applies_when" value="Appeal to Judge"/>
      <metadata name="goalcat:aggregate" value="mean"/>
      <metadata name="goalcat:provenance" value="statutory"/>
      <metadata name="goalcat:source" value="threshold 30 d: Art. 204-bis D.Lgs. 285/1992, the window for a ricorso al Giudice di Pace -- half the Prefecture window, which v1.1 collapsed into a single 60-day indicator taken from Mannhardt et al. (2016, Fig. 8)'s Delay Judge' guard rather than from the statute. worst 60 d illustrative (2x)."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Average time to case closure (days)" id="114" type="Indicator" groups="115">
      <metadata name="goalcat:measure" value="duration_days"/>
      <metadata name="goalcat:from" value="Create Fine"/>
      <metadata name="goalcat:to" value="Payment|Send for Credit Collection|Receive Result Appeal from Prefecture|Notify Result Appeal to Offender"/>
      <metadata name="goalcat:to_occurrence" value="last"/>
      <metadata name="goalcat:aggregate" value="mean"/>
      <metadata name="goalcat:provenance" value="external-by-analogy"/>
      <metadata name="goalcat:source" value="threshold 180 d: L. 241/1990 art. 2, which caps any administrative proceeding's term at 180 days. target 150 d: Art. 201's 90-day notification term plus Art. 203's 60-day payment/appeal window, i.e. the earliest lawful completion of an uncontested case. worst 365 d illustrative. Replaces v1.1's acknowledged invented placeholder."/>
    </intElements>
    <actors name="Traffic Police Back-Office" id="1"/>
