<?xml version="1.0" encoding="UTF-8"?>
<urn:URNspec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:grl="http:///grl.ecore" xmlns:grl.kpimodel="http:///grl/kpimodel.ecore" xmlns:urn="http:///urn.ecore" name="BPIC2020 Goal Model" author="goalcat (artificial -- see data/goals/bpic2020GM_description.md)" created="August 19, 2026, 12:00:00 AM EDT" modified="August 28, 2026, 12:00:00 AM EDT" specVersion="1.0" urnVersion="1.27" nextGlobalID="84">
  <grlspec>
    <intElements name="Every submitted permit reaches a documented authorization outcome, and every cost from an approved trip is paid" id="2" type="Goal" decompositionType="And"/>
    <intElements name="Permit is submitted for authorization" id="3" type="Goal" decompositionType="And"/>
    <intElements name="Permit reaches a closed resolution" id="4" type="Goal" decompositionType="Or"/>
    <intElements name="Permit is approved and its trip/costs are settled" id="5" type="Goal" decompositionType="And"/>
    <intElements name="Trip is undertaken and its costs are settled" id="6" type="Goal" decompositionType="And"/>
    <intElements name="Costs arising from the trip are declared or requested, and paid" id="7" type="Goal" decompositionType="Or"/>
    <intElements name="Permit SUBMITTED by EMPLOYEE" id="8" type="Task"/>
    <intElements name="Permit is rejected and not further pursued" id="9" type="Task"/>
    <intElements name="Permit is approved through the required chain" id="10" type="Task"/>
    <intElements name="Start trip &#8594; End trip" id="11" type="Task"/>
    <intElements name="Declaration submitted, approved, and paid" id="12" type="Task"/>
    <intElements name="Request For Payment submitted, approved, and paid" id="13" type="Task"/>
    <intElements name="Minimize approval-chain overhead" id="14" type="Softgoal"/>
    <intElements name="Maintain budgetary control" id="15" type="Softgoal"/>
    <intElements name="Minimize employee reimbursement delay" id="16" type="Softgoal"/>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Time to reimbursement (days)" id="17" type="Indicator" groups="37">
      <metadata name="goalcat:measure" value="duration_days"/>
      <metadata name="goalcat:from" value="Declaration SUBMITTED by EMPLOYEE|Request For Payment SUBMITTED by EMPLOYEE"/>
      <metadata name="goalcat:to" value="Payment Handled"/>
      <metadata name="goalcat:to_occurrence" value="last"/>
      <metadata name="goalcat:aggregate" value="mean"/>
      <metadata name="goalcat:provenance" value="external-by-analogy"/>
      <metadata name="goalcat:source" value="target 30 d: Directive 2011/7/EU art. 4 sets 30 days as the payment term when the debtor is a public authority, the norm the Dutch central government also reports itself against; TU/e is a publicly funded university. threshold 60 d: the exceptional public-authority ceiling in art. 4(4). worst 120 d illustrative. Applied by analogy -- an employee reimbursement is not itself a commercial invoice. Measurement frame: ICPM 2020 challenge throughput question (Klein et al. 2020, Q1)."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Budget overspend rate (%)" id="18" type="Indicator" groups="38">
      <metadata name="goalcat:measure" value="case_fraction"/>
      <metadata name="goalcat:numerator" value="attr:Overspent=true"/>
      <metadata name="goalcat:scale" value="percent"/>
      <metadata name="goalcat:provenance" value="illustrative"/>
      <metadata name="goalcat:source" value="Numerator is the log's own case:Overspent boolean, computed by the log's publisher. No public source states an acceptable overspend rate; target 0 / threshold 15 / worst 40 (%) are illustrative bounds around the observed 26.8%."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Approval-chain rejection rate (%)" id="19" type="Indicator" groups="38">
      <metadata name="goalcat:measure" value="case_fraction"/>
      <metadata name="goalcat:among" value="Permit FINAL_APPROVED by SUPERVISOR|Permit FINAL_APPROVED by DIRECTOR"/>
      <metadata name="goalcat:numerator" value="before:Permit REJECTED by ADMINISTRATION|Permit REJECTED by BUDGET OWNER|Permit REJECTED by SUPERVISOR|Permit REJECTED by DIRECTOR|Permit REJECTED by PRE_APPROVER|Permit REJECTED by EMPLOYEE|Permit REJECTED by MISSING >> Permit FINAL_APPROVED by SUPERVISOR|Permit FINAL_APPROVED by DIRECTOR"/>
      <metadata name="goalcat:scale" value="percent"/>
      <metadata name="goalcat:provenance" value="illustrative"/>
      <metadata name="goalcat:source" value="Denominator: permits that reach a final approval. Numerator: those rejected at least once before it. No external KPI target; target 0 / threshold 10 / worst 25 (%) are illustrative bounds around the observed 4.6%."/>
    </intElements>
    <actors name="Travel &amp; Finance Administration" id="1"/>
