    <groups name="KPI conversion value sets" id="39" strategies="40"/>
    <strategies name="Conversion baseline" id="40" author="goalcat (artificial -- see data/goals/bpic2020GM_description.md)" type="Private" group="39">
      <evaluations intElement="17">
        <kpiEvalValueSet targetValue="30" thresholdValue="60" worstValue="120" unit="days" qualitativeEvaluationValue="target/threshold from Directive 2011/7/EU art. 4 (30-day public-authority term, 60-day exceptional ceiling); worst illustrative. Not measured here -- Step 7b writes one measured strategy per category. See bpic2020GM_description.md SS6."/>
      </evaluations>
      <evaluations intElement="18">
        <kpiEvalValueSet targetValue="0" thresholdValue="15" worstValue="40" unit="%" qualitativeEvaluationValue="Illustrative bounds, no organizational target -- observed rate 26.8% (1,894/7,065) from the log's own case:Overspent attribute. See bpic2020GM_description.md SS6/SS8."/>
      </evaluations>
      <evaluations intElement="19">
        <kpiEvalValueSet targetValue="0" thresholdValue="10" worstValue="25" unit="%" qualitativeEvaluationValue="Illustrative bounds, no organizational target -- observed rate 4.6% (319/6,960). See bpic2020GM_description.md SS6/SS8."/>
      </evaluations>
    </strategies>
    <impactModel/>
    <featureModel/>
  </grlspec>
