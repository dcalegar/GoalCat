<?xml version="1.0" encoding="UTF-8"?>
<urn:URNspec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:grl="http:///grl.ecore" xmlns:grl.kpimodel="http:///grl/kpimodel.ecore" xmlns:urn="http:///urn.ecore" name="BPIC2019 Goal Model" author="goalcat (artificial -- see data/goals/bpic2019GM_description.md)" created="August 19, 2026, 12:00:00 AM EDT" modified="August 28, 2026, 12:00:00 AM EDT" specVersion="1.0" urnVersion="1.27" nextGlobalID="108">
  <grlspec>
    <intElements name="Every purchase order item reaches a matched, compliant closure" id="2" type="Goal" decompositionType="And"/>
    <intElements name="Item is created and, where applicable, requisitioned" id="3" type="Goal" decompositionType="And"/>
    <intElements name="Item is resolved per its matching regime" id="4" type="Goal" decompositionType="Or"/>
    <intElements name="3-way matched, invoice recorded after goods receipt" id="5" type="Goal" decompositionType="And"/>
    <intElements name="3-way matched, invoice recorded before goods receipt" id="6" type="Goal" decompositionType="And"/>
    <intElements name="2-way matched (no goods receipt required)" id="7" type="Goal" decompositionType="And"/>
    <intElements name="Create Purchase Order Item" id="8" type="Task"/>
    <intElements name="Requisition &amp; release (optional upstream gate)" id="9" type="Task"/>
    <intElements name="Record Goods Receipt" id="10" type="Task"/>
    <intElements name="Record invoice" id="11" type="Task"/>
    <intElements name="Clear Invoice" id="12" type="Task"/>
    <intElements name="Resolve via consignment consumption" id="13" type="Task"/>
    <intElements name="Minimize procurement &amp; matching overhead" id="14" type="Softgoal"/>
    <intElements name="Maximize working-capital efficiency (timely clearance)" id="15" type="Softgoal"/>
    <intElements name="Preserve value-matching control integrity" id="16" type="Softgoal"/>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Time to clearance, 3-way after GR (days)" id="17" type="Indicator" groups="47">
      <metadata name="goalcat:measure" value="duration_days"/>
      <metadata name="goalcat:from" value="Record Invoice Receipt"/>
      <metadata name="goalcat:to" value="Clear Invoice"/>
      <metadata name="goalcat:to_occurrence" value="first"/>
      <metadata name="goalcat:aggregate" value="mean"/>
      <metadata name="goalcat:provenance" value="external-by-analogy"/>
      <metadata name="goalcat:source" value="target 30 d / threshold 60 d: Directive 2011/7/EU on combating late payment in commercial transactions, arts. 3(3) and 3(5) -- the 30-day default B2B payment term and the 60-day maximum an agreement may set. In this regime the invoice follows goods receipt, so per art. 3(3)(b) the term runs from Record Invoice Receipt (the later event). worst 120 d illustrative (2x the maximum). Measurement frame: ICPM 2019 challenge process question 2 (time between goods receipt, invoice receipt and payment)."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Time to clearance, 3-way before GR (days)" id="18" type="Indicator" groups="47">
      <metadata name="goalcat:measure" value="duration_days"/>
      <metadata name="goalcat:from" value="Record Goods Receipt"/>
      <metadata name="goalcat:to" value="Clear Invoice"/>
      <metadata name="goalcat:to_occurrence" value="first"/>
      <metadata name="goalcat:aggregate" value="mean"/>
      <metadata name="goalcat:provenance" value="external-by-analogy"/>
      <metadata name="goalcat:source" value="Same value set and source as indicator 17 (Directive 2011/7/EU arts. 3(3), 3(5)). Here the invoice precedes goods receipt, so per art. 3(3)(b) the term runs from Record Goods Receipt (the later event)."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Time to clearance, 2-way match (days)" id="19" type="Indicator" groups="47">
      <metadata name="goalcat:measure" value="duration_days"/>
      <metadata name="goalcat:from" value="Record Invoice Receipt"/>
      <metadata name="goalcat:to" value="Clear Invoice"/>
      <metadata name="goalcat:to_occurrence" value="first"/>
      <metadata name="goalcat:aggregate" value="mean"/>
      <metadata name="goalcat:provenance" value="external-by-analogy"/>
      <metadata name="goalcat:source" value="Same value set and source as indicator 17 (Directive 2011/7/EU arts. 3(3), 3(5)). This regime records no goods receipt, so the term runs from Record Invoice Receipt."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="3-way matching compliance (violation rate, %)" id="20" type="Indicator" groups="48">
      <metadata name="goalcat:measure" value="case_fraction"/>
      <metadata name="goalcat:among" value="Clear Invoice"/>
      <metadata name="goalcat:numerator" value="lacks:Record Goods Receipt"/>
      <metadata name="goalcat:scale" value="percent"/>
      <metadata name="goalcat:provenance" value="illustrative"/>
      <metadata name="goalcat:source" value="Denominator: items that reach Clear Invoice. Numerator: those cleared with no Record Goods Receipt ever logged -- the deviation the ICPM 2019 challenge process question 3 asks about. No organizer-published target for an acceptable violation rate exists; target 0 / threshold 1 / worst 5 (%) are illustrative bounds around the observed 0.31%."/>
    </intElements>
    <intElements xsi:type="grl.kpimodel:Indicator" name="Exception/rework rate (%)" id="21" type="Indicator" groups="48">
      <metadata name="goalcat:measure" value="case_fraction"/>
      <metadata name="goalcat:numerator" value="has:Cancel Invoice Receipt|Cancel Goods Receipt|Block Purchase Order Item|Set Payment Block"/>
      <metadata name="goalcat:scale" value="percent"/>
      <metadata name="goalcat:provenance" value="illustrative"/>
      <metadata name="goalcat:source" value="Share of items carrying at least one cancellation or block event. No external source defines this as a formal KPI; target 0 / threshold 5 / worst 15 (%) are illustrative bounds on SG1 around the observed 3.39%."/>
    </intElements>
    <actors name="Purchase-to-Pay Back-Office" id="1"/>
