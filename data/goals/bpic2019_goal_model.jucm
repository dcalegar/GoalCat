    <groups name="KPI conversion value sets" id="49" strategies="50"/>
    <strategies name="Conversion baseline" id="50" author="goalcat (artificial -- see data/goals/bpic2019GM_description.md)" type="Private" group="49">
      <evaluations intElement="17">
        <kpiEvalValueSet targetValue="30" thresholdValue="60" worstValue="120" unit="days" qualitativeEvaluationValue="target/threshold from Directive 2011/7/EU (30-day default, 60-day maximum B2B term); worst illustrative. Not measured here -- Step 7b writes one measured strategy per category. See bpic2019GM_description.md SS6."/>
      </evaluations>
      <evaluations intElement="18">
        <kpiEvalValueSet targetValue="30" thresholdValue="60" worstValue="120" unit="days" qualitativeEvaluationValue="target/threshold from Directive 2011/7/EU (30-day default, 60-day maximum B2B term); worst illustrative. Not measured here -- Step 7b writes one measured strategy per category. See bpic2019GM_description.md SS6."/>
      </evaluations>
      <evaluations intElement="19">
        <kpiEvalValueSet targetValue="30" thresholdValue="60" worstValue="120" unit="days" qualitativeEvaluationValue="target/threshold from Directive 2011/7/EU (30-day default, 60-day maximum B2B term); worst illustrative. Not measured here -- Step 7b writes one measured strategy per category. See bpic2019GM_description.md SS6."/>
      </evaluations>
      <evaluations intElement="20">
        <kpiEvalValueSet targetValue="0" thresholdValue="1" worstValue="5" unit="%" qualitativeEvaluationValue="Illustrative bounds, no organizational target -- observed rate 0.31% (566/183,374). See bpic2019GM_description.md SS6/SS8."/>
      </evaluations>
      <evaluations intElement="21">
        <kpiEvalValueSet targetValue="0" thresholdValue="5" worstValue="15" unit="%" qualitativeEvaluationValue="Illustrative bounds, no organizational target -- observed rate 3.39% (8,523/251,734). See bpic2019GM_description.md SS6/SS8."/>
      </evaluations>
    </strategies>
    <impactModel/>
    <featureModel/>
  </grlspec>
